# Copy to .env to customise. Defaults work out of the box.

# --- Database ---------------------------------------------------------
# SQLite by default: a single file, no server to install or run.
DATABASE_URL=sqlite:///contractiq.db

# Any other SQLAlchemy URL also works, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/contractiq

# --- App --------------------------------------------------------------
APP_ENV=development

# Comma separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:8443,http://127.0.0.1:8443,http://localhost:5173,http://127.0.0.1:5173

# --- Uploads ----------------------------------------------------------
MAX_UPLOAD_MB=25
